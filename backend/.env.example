# Copy to .env and fill real values. Never commit .env.
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./agentos.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Provider: anthropic | groq | openai | gemini
LLM_PROVIDER=anthropic
LLM_MOCK=true

# Anthropic Configuration
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-4-6

# Groq Configuration
GROQ_API_KEY=your_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4000
GROQ_TIMEOUT_SECONDS=90
GROQ_REASONING_EFFORT=low

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Upstash Redis Cache (Optional for distributed rate-limiting and session cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth & Rate Limiting
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60
LLM_CALLS_PER_HOUR=60
